@startuml usecase_diagram
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Sender Client" as Sender
actor "Delivery Rider" as Rider

rectangle "Hyperlocal Courier Dispatch & Tracking Engine" {
  usecase "Place Courier Request" as UC1
  usecase "Match Nearest Rider" as UC2
  usecase "Track Delivery Status" as UC3
  usecase "Cancel Order" as UC4
  usecase "Toggle Availability" as UC5
  usecase "Receive Dispatch Notification" as UC6
  usecase "Optimize Multi-Stop Route" as UC7
  usecase "Complete Delivery" as UC8
  usecase "Verify OTP" as UC9

  UC1 .> UC2 : <<include>>
  UC8 .> UC9 : <<include>>
  UC4 .> UC3 : <<extend>>
  UC7 .> UC6 : <<extend>>
}

Sender -- UC1
Sender -- UC3
Sender -- UC4
Rider -- UC5
Rider -- UC6
Rider -- UC8

@enduml
